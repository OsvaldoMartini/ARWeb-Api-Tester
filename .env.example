# Copy to .env. The app runs WITHOUT login. These are optional integrations only.

# Node sidecar HTTP port (React talks to the sidecar on this port)
SIDECAR_PORT=8787

# Local mock server default port (localhost-only by default)
MOCK_SERVER_PORT=8855

# SQLite database file (relative to repo root or absolute)
DATABASE_PATH=./data/app.db

# Optional AI provider keys (encrypted at rest in SQLite once configured in the UI).
# Leave blank to run fully offline / rule-based.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
TOGETHER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
