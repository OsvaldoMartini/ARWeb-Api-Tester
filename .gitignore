# dependencies
node_modules/
.pnp/
.pnp.js

# build output
dist/
build/
*.tsbuildinfo
packages/*/dist/
server-arapi/dist/
server-ar/dist/
src-arapi/target/
src-arapi/gen/
src-arapi/binaries/
src-ar/target/
src-ar/gen/
src-ar/binaries/

# data (runtime, do not commit local DB)
data/app.db
data/app.db-*
data/exports/*
!data/exports/.gitkeep

# env / secrets
.env
.env.*
!.env.example

# logs
*.log
logs/

# releases — binary artifacts are ignored; only INDEX.md is tracked
releases/v*/
!releases/INDEX.md

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
data/.arweb.key
