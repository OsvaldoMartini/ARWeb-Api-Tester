          "$ref" : "#/components/parameters/Filter"
        }, {
          "$ref" : "#/components/parameters/PageLimit"
        }, {
          "$ref" : "#/components/parameters/PageOffset"
        }, {
          "$ref" : "#/components/parameters/HrefActive"
        }, {
          "$ref" : "#/components/parameters/IncludeInactive"
        }, {
          "$ref" : "#/components/parameters/Accept-Encoding"
        }, {
          "$ref" : "#/components/parameters/Accept-Language"
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful response",
            "headers" : {
              "Content-Language" : {
                "$ref" : "#/components/headers/Content-Language"
              },
              "X-Has-Next-Page" : {
                "$ref" : "#/components/headers/X-Has-Next-Page"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/obj_feep"
                  }
                }
              }
            }
          },
          "default" : {
            "$ref" : "#/components/responses/Problem"
          }
        }
      }
    },
    "/obj-feeps/{obj_feep_id}" : {
      "get" : {
        "tags" : [ "API endpoints" ],
        "summary" : "Get a Fee Profile object",
        "description" : "*Get a `Fee Profile` object by ID*.\nOnly `Fee Profile` object will be returned that can be accessed by the user (security applied).\nIf user does not have access to resource, not found error will be returned instead of unauthorized - to disallow attacks.\n",
        "parameters" : [ {
          "in" : "path",
          "name" : "obj_feep_id",
          "schema" : {
            "type" : "string"
          },
          "required" : true,
          "description" : "ID of the `Fee Profile` object to get"
        }, {
          "$ref" : "#/components/parameters/HrefActive"
        }, {
          "$ref" : "#/components/parameters/IncludeInactive"
        }, {
          "$ref" : "#/components/parameters/Accept-Encoding"
        }, {
          "$ref" : "#/components/parameters/If-None-Match"
        }, {
          "$ref" : "#/components/parameters/Accept-Language"
