          "$ref" : "#/components/parameters/Filter"
        }, {
          "$ref" : "#/components/parameters/PageLimit"
        }, {
          "$ref" : "#/components/parameters/PageOffset"
        }, {
          "$ref" : "#/components/parameters/HrefActive"
        }, {
          "$ref" : "#/components/parameters/IncludeInactive"
        }, {
          "$ref" : "#/components/parameters/Accept-Encoding"
        }, {
          "$ref" : "#/components/parameters/Accept-Language"
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful response",
            "headers" : {
              "Content-Language" : {
                "$ref" : "#/components/headers/Content-Language"
              },
              "X-Has-Next-Page" : {
                "$ref" : "#/components/headers/X-Has-Next-Page"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/obj_lihi"
                  }
                }
              }
            }
          },
          "default" : {
            "$ref" : "#/components/responses/Problem"
          }
        }
      }
    },
    "/obj-lihis/{obj_lihi_id}" : {
      "get" : {
        "tags" : [ "API endpoints" ],
        "summary" : "Get a Limit Hierarchy object",
        "description" : "*Get a `Limit Hierarchy` object by ID*.\nOnly `Limit Hierarchy` object will be returned that can be accessed by the user (security applied).\nIf user does not have access to resource, not found error will be returned instead of unauthorized - to disallow attacks.\n",
        "parameters" : [ {
          "in" : "path",
          "name" : "obj_lihi_id",
          "schema" : {
            "type" : "string"
          },
          "required" : true,
          "description" : "ID of the `Limit Hierarchy` object to get"
        }, {
          "$ref" : "#/components/parameters/HrefActive"
        }, {
          "$ref" : "#/components/parameters/IncludeInactive"
        }, {
          "$ref" : "#/components/parameters/Accept-Encoding"
        }, {
          "$ref" : "#/components/parameters/If-None-Match"
        }, {
          "$ref" : "#/components/parameters/Accept-Language"
