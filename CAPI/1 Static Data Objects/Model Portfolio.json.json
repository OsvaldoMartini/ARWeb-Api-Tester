      "get" : {
        "tags" : [ "API endpoints" ],
        "summary" : "Get Model Portfolio objects.",
        "description" : "Get a collection of `Model Portfolio` objects.\nThe result set can be restricted through filter parameter.\nOnly `Model Portfolio` objects will be returned that can be accessed by the user (security applied).\nPaging is supported with parameters *limit* and *offset*.\n",
        "parameters" : [ {
          "$ref" : "#/components/parameters/Filter"
        }, {
          "$ref" : "#/components/parameters/PageLimit"
        }, {
          "$ref" : "#/components/parameters/PageOffset"
        }, {
          "$ref" : "#/components/parameters/HrefActive"
        }, {
          "$ref" : "#/components/parameters/IncludeInactive"
        }, {
          "$ref" : "#/components/parameters/Accept-Encoding"
        }, {
          "$ref" : "#/components/parameters/Accept-Language"
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful response",
            "headers" : {
              "Content-Language" : {
                "$ref" : "#/components/headers/Content-Language"
              },
              "X-Has-Next-Page" : {
                "$ref" : "#/components/headers/X-Has-Next-Page"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/obj_mpf"
                  }
                }
              }
            }
          },
          "default" : {
            "$ref" : "#/components/responses/Problem"
          }
        }
      }
    },
    "/obj-mpfs/{obj_mpf_id}" : {
      "get" : {
        "tags" : [ "API endpoints" ],
        "summary" : "Get a Model Portfolio object",
        "description" : "*Get a `Model Portfolio` object by ID*.\nOnly `Model Portfolio` object will be returned that can be accessed by the user (security applied).\nIf user does not have access to resource, not found error will be returned instead of unauthorized - to disallow attacks.\n",
        "parameters" : [ {
          "in" : "path",
          "name" : "obj_mpf_id",
          "schema" : {
            "type" : "string"
          },
          "required" : true,
          "description" : "ID of the `Model Portfolio` object to get"
        }, {
          "$ref" : "#/components/parameters/HrefActive"
        }, {
          "$ref" : "#/components/parameters/IncludeInactive"
        }, {
          "$ref" : "#/components/parameters/Accept-Encoding"
        }, {
          "$ref" : "#/components/parameters/If-None-Match"
        }, {
          "$ref" : "#/components/parameters/Accept-Language"
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful response",
            "headers" : {
              "Content-Language" : {
                "$ref" : "#/components/headers/Content-Language"
              },
              "ETag" : {
                "$ref" : "#/components/headers/ETag"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/obj_mpf"
                }
              }
            }
          },
          "304" : {
            "description" : "Not modified"
          },
          "default" : {
            "$ref" : "#/components/responses/Problem"
          }
        }
      }
    }
