  "paths" : {
    "/doc-valadjs" : {
      "get" : {
        "tags" : [ "API endpoints" ],
        "summary" : "Get Value Adjust orders.",
        "description" : "Get a collection of `Value Adjust` orders.\nThe result set can be restricted through filter parameter.\nOnly `Value Adjust` orders will be returned that can be accessed by the user (security applied).\nPaging is supported with parameters *limit* and *offset*.\n",
        "parameters" : [ {
          "$ref" : "#/components/parameters/Filter"
        }, {
          "$ref" : "#/components/parameters/DocPool"
        }, {
          "$ref" : "#/components/parameters/PageLimit"
        }, {
          "$ref" : "#/components/parameters/PageOffset"
        }, {
          "$ref" : "#/components/parameters/HrefActive"
        }, {
          "$ref" : "#/components/parameters/IncludeInactive"
        }, {
          "$ref" : "#/components/parameters/Accept-Encoding"
        }, {
          "$ref" : "#/components/parameters/Accept-Language"
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful response",
            "headers" : {
              "Content-Language" : {
                "$ref" : "#/components/headers/Content-Language"
              },
              "X-Has-Next-Page" : {
                "$ref" : "#/components/headers/X-Has-Next-Page"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/doc_valadj"
                  }
                }
              }
            }
          },
          "default" : {
            "$ref" : "#/components/responses/Problem"
          }
        }
      }
    },
    "/doc-valadjs/{doc_valadj_id}" : {
      "get" : {
        "tags" : [ "API endpoints" ],
        "summary" : "Get a Value Adjust order",
        "description" : "*Get a `Value Adjust` order by ID*.\nOnly `Value Adjust` order will be returned that can be accessed by the user (security applied).\nIf user does not have access to resource, not found error will be returned instead of unauthorized - to disallow attacks.\n",
        "parameters" : [ {
          "in" : "path",
          "name" : "doc_valadj_id",
          "schema" : {
            "type" : "string"
          },
          "required" : true,
          "description" : "ID of the `Value Adjust` order to get"
        }, {
          "$ref" : "#/components/parameters/HrefActive"
        }, {
          "$ref" : "#/components/parameters/IncludeInactive"
        }, {
          "$ref" : "#/components/parameters/Accept-Encoding"
        }, {
          "$ref" : "#/components/parameters/If-None-Match"
        }, {
          "$ref" : "#/components/parameters/Accept-Language"
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful response",
            "headers" : {
              "Content-Language" : {
                "$ref" : "#/components/headers/Content-Language"
              },
              "ETag" : {
                "$ref" : "#/components/headers/ETag"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/doc_valadj"
                }
              }
            }
          },
          "304" : {
            "description" : "Not modified"
          },
          "default" : {
            "$ref" : "#/components/responses/Problem"
          }
        }
      }
    }
  },
