  "paths" : {
    "/doc-secevt2-poss" : {
      "get" : {
        "tags" : [ "API endpoints" ],
        "summary" : "Get Security Event triggering positions",
        "description" : "Get a collection of `Security Event Triggering Positions` \nThe result set can be restricted through filter parameter.\nOnly `Security Event Positions` will be returned that can be accessed by the user (security applied).\nPaging is supported with parameters *limit* and *offset*.\n",
        "parameters" : [ {
          "$ref" : "#/components/parameters/Aft"
        }, {
          "$ref" : "#/components/parameters/Bp"
        }, {
          "$ref" : "#/components/parameters/Pos"
        }, {
          "$ref" : "#/components/parameters/DeadlineDateFrom"
        }, {
          "$ref" : "#/components/parameters/Open"
        }, {
          "$ref" : "#/components/parameters/PageLimit"
        }, {
          "$ref" : "#/components/parameters/PageOffset"
        }, {
          "$ref" : "#/components/parameters/Accept-Encoding"
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful response",
            "headers" : {
              "Content-Language" : {
                "$ref" : "#/components/headers/Content-Language"
              },
              "X-Has-Next-Page" : {
                "$ref" : "#/components/headers/X-Has-Next-Page"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/doc_secevt2_pos"
                  }
                }
              }
            }
          },
          "default" : {
            "$ref" : "#/components/responses/Problem"
          }
        }
      }
    },
    "/doc-secevt2-poss/{id}" : {
      "get" : {
        "tags" : [ "API endpoints" ],
        "summary" : "Get a Security Event triggering position",
        "description" : "*Get a `Security Event Triggering Position` order by Triggering position ID*.\nOnly `Security Event Positions` will be returned that can be accessed by the user (security applied).\nIf user does not have access to resource, not found error will be returned instead of unauthorized - to disallow attacks.\n",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "schema" : {
            "type" : "string"
          },
          "required" : true,
          "description" : "ID of the `Security Event Triggering Position` to get"
        }, {
          "$ref" : "#/components/parameters/Accept-Encoding"
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful response",
            "headers" : {
              "Content-Language" : {
                "$ref" : "#/components/headers/Content-Language"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/doc_secevt2_pos"
                }
              }
            }
          },
          "304" : {
            "description" : "Not modified"
          },
          "default" : {
            "$ref" : "#/components/responses/Problem"
          }
        }
      },
      "patch" : {
        "tags" : [ "API endpoints" ],
        "summary" : "Modify/update an existing Security Event triggering position",
        "description" : "*Partially modify/update an existing `Security Event Triggering Position` by ID*.\n",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "schema" : {
            "type" : "string"
          },
          "required" : true,
          "description" : "ID of the `Security Event Triggering Position` to modify/update"
        }, {
          "$ref" : "#/components/parameters/Accept-Encoding"
        } ],
        "requestBody" : {
          "required" : true,
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/doc_secevt2_pos_patch"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "Request successfully processed"
          },
          "default" : {
            "$ref" : "#/components/responses/Problem"
          }
        }
      }
    }
  },
