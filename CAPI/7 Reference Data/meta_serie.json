{
  "openapi" : "3.0.2",
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "info" : {
    "title" : "meta_serie API",
    "version" : "1.0.0",
    "x-avq$categories" : [ "capi" ]
  },
  "servers" : [ {
    "url" : "/api1/",
    "description" : "Development server"
  } ],
  "paths" : {
    "/meta-series" : {
      "get" : {
        "tags" : [ "API endpoints" ],
        "summary" : "Get meta_serie references.",
        "description" : "Get a collection of `meta_serie` references.\nThe result set can be restricted through filter parameter.\nOnly `meta_serie` references will be returned that can be accessed by the user (security applied).\nPaging is supported with parameters *limit* and *offset*.\n",
        "parameters" : [ {
          "$ref" : "#/components/parameters/Filter"
        }, {
          "$ref" : "#/components/parameters/PageLimit"
        }, {
          "$ref" : "#/components/parameters/PageOffset"
        }, {
          "$ref" : "#/components/parameters/HrefActive"
        }, {
          "$ref" : "#/components/parameters/IncludeInactive"
        }, {
          "$ref" : "#/components/parameters/Accept-Encoding"
        }, {
          "$ref" : "#/components/parameters/Accept-Language"
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful response",
            "headers" : {
              "Content-Language" : {
                "$ref" : "#/components/headers/Content-Language"
              },
              "X-Has-Next-Page" : {
                "$ref" : "#/components/headers/X-Has-Next-Page"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/meta_serie"
                  }
                }
              }
            }
          },
          "default" : {
            "$ref" : "#/components/responses/Problem"
          }
        }
      }
    },
    "/meta-series/{meta_serie_id}" : {
      "get" : {
        "tags" : [ "API endpoints" ],
        "summary" : "Get a meta_serie reference",
        "description" : "*Get a `meta_serie` reference by ID*.\nOnly `meta_serie` reference will be returned that can be accessed by the user (security applied).\nIf user does not have access to resource, not found error will be returned instead of unauthorized - to disallow attacks.\n",
        "parameters" : [ {
          "in" : "path",
          "name" : "meta_serie_id",
          "schema" : {
            "type" : "string"
          },
          "required" : true,
          "description" : "ID of the `meta_serie` reference to get"
        }, {
          "$ref" : "#/components/parameters/HrefActive"
        }, {
          "$ref" : "#/components/parameters/IncludeInactive"
        }, {
          "$ref" : "#/components/parameters/Accept-Encoding"
        }, {
          "$ref" : "#/components/parameters/If-None-Match"
        }, {
          "$ref" : "#/components/parameters/Accept-Language"
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful response",
            "headers" : {
              "Content-Language" : {
                "$ref" : "#/components/headers/Content-Language"
              },
              "ETag" : {
                "$ref" : "#/components/headers/ETag"
              }
            },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/meta_serie"
                }
              }
            }
          },
          "304" : {
            "description" : "Not modified"
          },
          "default" : {
            "$ref" : "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components" : {
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    },
    "schemas" : {
      "meta_series" : {
        "title" : "List of meta_serie",
        "type" : "array",
        "items" : {
          "$ref" : "#/components/schemas/meta_serie"
        },
        "uniqueItems" : true
      },
      "code_tab_ref" : {
        "title" : "code_tab_ref",
        "type" : "object",
        "properties" : {
          "_href" : {
            "description" : "Reference/link",
            "type" : "string",
            "readOnly" : true
          },
          "id" : {
            "description" : "Numeric reference",
            "type" : "integer",
            "format" : "int32"
          },
          "ident" : {
            "description" : "Unique symbolic reference",
            "type" : "string"
          },
          "intlId" : {
            "description" : "Symbolic reference",
            "type" : "string",
            "readOnly" : true
          }
        }
      },
      "meta_serie" : {
        "title" : "meta_serie",
        "type" : "object",
        "properties" : {
          "activ" : {
            "type" : "boolean",
            "readOnly" : true
          },
          "agingComprOpt" : {
            "description" : "Referencing: `/code-aging-compr-opts/{id}`",
            "allOf" : [ {
              "$ref" : "#/components/schemas/code_tab_ref"
            } ],
            "readOnly" : true
          },
          "agingEntity" : {
            "description" : "Referencing: `/code-aging-entitys/{id}`",
            "allOf" : [ {
              "$ref" : "#/components/schemas/code_tab_ref"
            } ],
            "readOnly" : true
          },
          "atrxSupport" : {
            "type" : "string",
            "readOnly" : true
          },
          "delDateExpr" : {
            "type" : "string",
            "readOnly" : true
          },
          "delDateExprIdx" : {
            "type" : "string",
            "readOnly" : true
          },
          "delLookAhead" : {
            "type" : "number",
            "readOnly" : true
          },
          "dsblBuSec" : {
            "type" : "string",
            "readOnly" : true
          },
          "id" : {
            "type" : "integer",
            "readOnly" : true
          },
          "ident" : {
            "type" : "string",
            "readOnly" : true
          },
          "intlId" : {
            "type" : "string",
            "readOnly" : true
          },
          "invdtViewMngt" : {
            "type" : "string",
            "readOnly" : true
          },
          "keepBeforeCompr" : {
            "type" : "string",
            "readOnly" : true
          },
          "keepDateExpr" : {
            "type" : "string",
            "readOnly" : true
          },
          "keepOnCloneUntil" : {
            "type" : "string",
            "readOnly" : true
          },
          "metaScriptTabId" : {
            "type" : "integer",
            "readOnly" : true
          },
          "name" : {
            "type" : "string",
            "readOnly" : true
          },
          "nameI18nList" : {
            "type" : "array",
            "items" : {
              "description" : "Full translation list for name field.<br>\n**_Only visible within compound APIs_**<br>\n",
              "allOf" : [ {
                "$ref" : "#/components/schemas/name_i18n"
              } ]
            },
            "readOnly" : true
          },
          "oracleAsSelect" : {
            "type" : "string",
            "readOnly" : true
          },
          "oracleStmt" : {
            "type" : "string",
            "readOnly" : true
          },
          "oracleTabAttr" : {
            "type" : "string",
            "readOnly" : true
          },
          "oracleTabAttrOnline" : {
            "type" : "string",
            "readOnly" : true
          },
          "preAlloc" : {
            "type" : "integer",
            "readOnly" : true
          },
          "serieTabType" : {
            "description" : "Referencing: `/code-serie-tab-types/{id}`",
            "allOf" : [ {
              "$ref" : "#/components/schemas/code_tab_ref"
            } ],
            "readOnly" : true
          },
          "tabName" : {
            "type" : "string",
            "readOnly" : true
          },
          "userId" : {
            "type" : "string",
            "readOnly" : true
          }
        }
      },
      "name_i18n" : {
        "title" : "name_i18n",
        "type" : "object",
        "properties" : {
          "lang" : {
            "description" : "Language<br>Referencing: `/code-langs/{id}`",
            "allOf" : [ {
              "$ref" : "#/components/schemas/code_tab_ref"
            } ],
            "readOnly" : true
          },
          "text" : {
            "type" : "string",
            "readOnly" : true
          }
        }
      }
    },
    "headers" : {
      "Content-Language" : {
        "schema" : {
          "type" : "string"
        }
      },
      "X-Has-Next-Page" : {
        "schema" : {
          "type" : "string"
        }
      },
      "Location" : {
        "schema" : {
          "type" : "string"
        },
        "description" : "Location of the created resource"
      },
      "ETag" : {
        "schema" : {
          "type" : "string"
        },
        "description" : "Current entity-tag"
      }
    },
    "parameters" : {
      "Filter" : {
        "name" : "filter",
        "in" : "query",
        "description" : "Expression to reduce the result set",
        "schema" : {
          "type" : "string"
        }
      },
      "PageLimit" : {
        "name" : "limit",
        "in" : "query",
        "description" : "Limits the number of items on a page",
        "schema" : {
          "type" : "integer",
          "default" : 5,
          "minimum" : 1,
          "maximum" : 200
        }
      },
      "PageOffset" : {
        "name" : "offset",
        "in" : "query",
        "description" : "Number of records to be skipped before selecting the result set",
        "schema" : {
          "type" : "integer",
          "minimum" : 0
        }
      },
      "HrefActive" : {
        "name" : "href",
        "in" : "query",
        "description" : "Activates the href",
        "schema" : {
          "type" : "boolean"
        }
      },
      "IncludeInactive" : {
        "name" : "include_inactive",
        "in" : "query",
        "description" : "Includes inactive data",
        "schema" : {
          "type" : "boolean"
        }
      },
      "If-None-Match" : {
        "name" : "If-None-Match",
        "in" : "header",
        "description" : "Specifies version known by client",
        "schema" : {
          "type" : "string"
        },
        "required" : false
      },
      "If-Match" : {
        "name" : "If-Match",
        "in" : "header",
        "description" : "Specifies entity-tag known by client",
        "schema" : {
          "type" : "string"
        },
        "required" : false
      },
      "Accept-Encoding" : {
        "name" : "Accept-Encoding",
        "in" : "header",
        "description" : "Compression scheme<br/> Warning: HTTP compression might not lead to better performance",
        "schema" : {
          "type" : "string"
        },
        "example" : "gzip, deflate",
        "required" : false
      },
      "Accept-Language" : {
        "name" : "Accept-Language",
        "in" : "header",
        "description" : "Specifies the language and locale that the client prefers",
        "schema" : {
          "type" : "string"
        },
        "example" : "de-CH, en-US",
        "required" : false
      },
      "X-Request-ID" : {
        "name" : "X-Request-ID",
        "in" : "header",
        "description" : "Specifies the request id in UUID format. If not provided, it will be generated automatically.",
        "schema" : {
          "type" : "string",
          "format" : "uuid"
        },
        "required" : false
      }
    },
    "responses" : {
      "Problem" : {
        "description" : "RFC7807 Problem",
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "type" : "object",
              "properties" : {
                "type" : {
                  "type" : "string"
                },
                "title" : {
                  "type" : "string"
                },
                "status" : {
                  "type" : "number",
                  "format" : "integer"
                },
                "detail" : {
                  "type" : "string"
                }
              },
              "additionalProperties" : true,
              "required" : [ "type", "title", "status" ]
            }
          }
        }
      }
    }
  }
}