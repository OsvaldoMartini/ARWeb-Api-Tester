{
  "name": "arweb-api-tester",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  “description”: “Monorepo: ARAPI Tester (src/ + src-arapi/ + server-arapi/) and AR Conversational (src-ar-web/ + src-ar/ + server-ar/). No C#.”,
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "server-arapi",
    "server-ar"
  ],
  "scripts": {
    "build:packages": "tsc -b packages/infrastructure packages/api-testing-engine packages/agents packages/mock-server packages/application packages/shared-ui",
    "dev:web": "vite",
    "dev:server": "npm run dev --workspace @arweb/server-arapi",
    "dev:server-ar": "npm run dev --workspace @arweb/server-ar",
    "dev": "npm run build:packages && concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:ar": "npm run build:packages && concurrently -n server-ar,web-ar -c magenta,cyan \"npm run dev:server-ar\" \"npx vite --config vite.config-ar.ts\"",
    "build": "npm run build:packages && tsc --noEmit && vite build",
    "build:vercel": "npm run build:packages && vite build",
    "build:ar": "npm run build:packages && tsc -p tsconfig.ar-web.json --noEmit && npx vite build --config vite.config-ar.ts",
    "build:server": "npm run build:packages && npm run build --workspace @arweb/server-arapi",
    "build:server-ar": "npm run build:packages && npm run build --workspace @arweb/server-ar",
    "sidecar:build": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "sidecar:build:ar": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar-ar.ps1",
    "installer:arapi": "powershell -ExecutionPolicy Bypass -File scripts/build-arapi.ps1",
    "installer:ar": "powershell -ExecutionPolicy Bypass -File scripts/build-ar.ps1",
    "tauri:ar": "tauri --config src-ar/tauri.conf.json",
    "tauri:ar:dev": "tauri dev --config src-ar/tauri.conf.json",
    "tauri:ar:build": "tauri build --config src-ar/tauri.conf.json",
    "preview": "vite preview",
    "preview:ar": "vite preview --config vite.config-ar.ts",
    "tauri": "tauri --config src-arapi/tauri.conf.json",
    "tauri:dev": "tauri dev --config src-arapi/tauri.conf.json",
    "tauri:build": "tauri build --config src-arapi/tauri.conf.json",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ar-web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test:e2e:docker": "docker run --rm -v \"$(pwd)\":/app -w /app -e BASE_URL=${BASE_URL:-https://ragstack.ch} mcr.microsoft.com/playwright:v1.60.0-noble npx playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@arweb/domain": "*",
    "@arweb/shared-ui": "*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@yao-pkg/pkg": "^5.11.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "vite": "$vite",
    "@yao-pkg/pkg": {
      "into-stream": "6.0.0"
    }
  }
}
