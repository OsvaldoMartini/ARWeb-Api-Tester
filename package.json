{
  "name": "arweb-api-tester",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ARWEB API Tester \u00e2\u20ac\u201d no-code banking API testing tool. React web app (src/) + Tauri shell (src-tauri/) + Node engine (server/). No C#.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "build:packages": "tsc -b packages/infrastructure packages/api-testing-engine packages/agents packages/mock-server packages/application packages/shared-ui",
    "dev:web": "vite",
    "dev:server": "npm run dev --workspace @arweb/server",
    "dev": "npm run build:packages && concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "build": "npm run build:packages && tsc --noEmit && vite build",
    "build:vercel": "npm run build:packages && vite build",
    "build:server": "npm run build:packages && npm run build --workspace @arweb/server",
    "sidecar:build": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@arweb/domain": "*",
    "@arweb/shared-ui": "*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@yao-pkg/pkg": "^5.11.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "vite": "$vite",
    "@yao-pkg/pkg": {
      "into-stream": "6.0.0"
    }
  }
}
