{
  "name": "arweb-api-tester",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Delivery monorepo for ARAPI and AR Conversational using the shared C# backend.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/common",
    "packages/domain",
    "packages/shared-ui"
  ],
  "scripts": {
    "build:packages": "tsc -b packages/common packages/domain packages/shared-ui",
    "dev:web": "vite",
    "dev:web:ar": "vite --config vite.config-ar.ts",
    "dev:backend-csharp": "powershell -ExecutionPolicy Bypass -File scripts/dev-backend-csharp.ps1",
    "dev": "npm run build:packages && concurrently -n backend,arapi -c blue,green \"npm run dev:backend-csharp\" \"npm run dev:web\"",
    "dev:ar": "npm run build:packages && concurrently -n backend,ar -c blue,cyan \"npm run dev:backend-csharp\" \"npm run dev:web:ar\"",
    "dev:both": "npm run build:packages && concurrently -n backend,arapi,ar -c blue,green,cyan \"npm run dev:backend-csharp\" \"npm run dev:web\" \"npm run dev:web:ar\"",
    "build": "npm run build:packages && tsc --noEmit && vite build",
    "build:vercel": "npm run build:packages && vite build",
    "build:ar": "npm run build:packages && tsc -p tsconfig.ar-web.json --noEmit && npx vite build --config vite.config-ar.ts",
    "build:server-csharp": "powershell -ExecutionPolicy Bypass -File scripts/build-arapi-csharp.ps1",
    "build:server-csharp:ar": "powershell -ExecutionPolicy Bypass -File scripts/build-arapi-csharp.ps1 -OutputDir src-ar\\binaries",
    "backend:build": "npm run build:server-csharp",
    "backend:build:ar": "npm run build:server-csharp:ar",
    "backend:build:all": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecars.ps1",
    "sidecar:build": "npm run build:server-csharp",
    "sidecar:build:ar": "npm run build:server-csharp:ar",
    "sidecar:build:all": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecars.ps1",
    "installer:arapi": "powershell -ExecutionPolicy Bypass -File scripts/build-arapi.ps1",
    "installer:ar": "powershell -ExecutionPolicy Bypass -File scripts/build-ar.ps1",
    "tauri:ar": "cd src-ar && tauri",
    "tauri:ar:dev": "cd src-ar && tauri dev",
    "tauri:ar:build": "cd src-ar && tauri build",
    "preview": "vite preview",
    "preview:ar": "vite preview --config vite.config-ar.ts",
    "tauri": "cd src-arapi && tauri",
    "tauri:dev": "cd src-arapi && tauri dev",
    "tauri:build": "cd src-arapi && tauri build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ar-web.json --noEmit"
  },
  "dependencies": {
    "@arweb/domain": "*",
    "@arweb/shared-ui": "*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "vite": "$vite"
  }
}
