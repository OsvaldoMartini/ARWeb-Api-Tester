{
  "name": "@arweb/server-ar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "SIDECAR_PORT=8788 tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/server-ar.mjs --packages=external",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@arweb/common": "*",
    "@arweb/domain": "*",
    "@arweb/application": "*",
    "@arweb/infrastructure": "*",
    "@arweb/agents": "*"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
