{
  "name": "@arweb/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/sidecar.mjs --packages=external",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@arweb/common": "*",
    "@arweb/domain": "*",
    "@arweb/application": "*",
    "@arweb/infrastructure": "*",
    "@arweb/api-testing-engine": "*",
    "@arweb/agents": "*",
    "@arweb/mock-server": "*"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2"
  },
  "comment": "swagger-parser is dev-listed so the importer can lazy-load it; move to dependencies when you bundle the sidecar for Tauri."
}
