{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability set: core window + shell permission to run the bundled sidecar only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-write-text-file",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/arapi-backend",
          "sidecar": true
        }
      ]
    }
  ]
}
