{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability set: core window + shell permission to run the bundled sidecar only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/arweb-sidecar",
          "sidecar": true
        }
      ]
    }
  ]
}
