{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@arweb/domain": ["packages/domain/src/index.ts"],
      "@arweb/application": ["packages/application/src/index.ts"],
      "@arweb/infrastructure": ["packages/infrastructure/src/index.ts"],
      "@arweb/api-testing-engine": ["packages/api-testing-engine/src/index.ts"],
      "@arweb/agents": ["packages/agents/src/index.ts"],
      "@arweb/mock-server": ["packages/mock-server/src/index.ts"],
      "@arweb/shared-ui": ["packages/shared-ui/src/index.ts"],
      "@arweb/common": ["packages/common/src/index.ts"]
    }
  }
}
